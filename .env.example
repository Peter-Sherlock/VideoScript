# 复制为 .env 后填写。离线 Mock 模式（--llm mock）不需要任何配置。

# 模型提供方：deepseek（默认）| openai_compat（其它 OpenAI 兼容服务）| mock（离线）
LLM_PROVIDER=deepseek
# DeepSeek API Key（https://platform.deepseek.com 获取）；openai_compat 时也可用 LLM_API_KEY
DEEPSEEK_API_KEY=
LLM_API_KEY=
# 接口地址与模型名（DeepSeek 当前可用：deepseek-flash、deepseek-v4-pro）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# DeepSeek 思考模式：disabled（默认，更快更省）| enabled（会回传 reasoning_content，但不写入 trace）
LLM_THINKING=disabled
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SEC=90

# 执行上限：达到上限返回 status=incomplete
AGENT_MAX_STEPS=14
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_CALLS_PER_TOOL=8
